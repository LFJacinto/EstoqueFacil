# Copie para .env ou exporte no terminal.
# Sem DATABASE_URL, a API roda com um repositório em memória e dados de exemplo.
DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque
PORT=3000
# custo-medio (padrão) ou ultimo-custo
CUSTEIO=custo-medio
# Opcional: URL de webhook para alertas de estoque mínimo (Slack, Teams...)
WEBHOOK_URL=
